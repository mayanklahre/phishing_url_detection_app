{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run main.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Flask app.py",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "args": [
        "run",
        "--no-debugger",
        "--no-reload"
      ],
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development"
      },
      "console": "integratedTerminal"
    }
  ]
}